MJ_APIKEY_PRIVATE=6xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx15
ACCEPT_BEARER_AUTH=false
COOKIE_SECURE=true

# Manual singleton Super Admin seed (run after the database schema is synchronized)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-at-least-12-characters
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Reverse browser coordinates into a displayable city/state/country
GEOAPIFY_API_KEY=your-geoapify-api-key
GEOAPIFY_TIMEOUT_MS=20000


# Zoho Books (OAuth refresh-token flow)
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
ZOHO_ORGANIZATION_ID=your-books-organization-id
ZOHO_DEFAULT_ITEM_ID=your-books-service-item-id
# Change both domains for the Zoho data center used by the organization.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com/books/v3
